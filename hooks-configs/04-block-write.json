{
  "model": "claude-opus-5",
  "effortLevel": "high",
  "permissions": {
    "allow": [
      "Bash(git log *)",
      "Bash(git -C ../cc-shared status)"
    ],
    "deny": [
      "Bash(git push *)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/hooks/block-writes.py"
          }
        ]
      }
    ]
  }
}
