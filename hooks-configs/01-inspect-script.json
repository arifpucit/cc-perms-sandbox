{
  "model": "claude-opus-5",
  "effortLevel": "high",
  "permissions": {
    "allow": [
      "Bash(git log *)",
      "Bash(git -C ../cc-shared status)"
    ],
    "deny": [
      "Bash(git push *)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/hooks/inspect-script.py"
          }
        ]
      }
    ]
  }
}
