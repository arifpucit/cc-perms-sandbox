{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-sonnet-5",
  "effortLevel": "medium",
  "defaultShell": "bash",
  "env": {
    "LAB_ENV": "perms-demo",
    "LAB_OWNER": "instructor",
    "LAB_TOKEN": "fake-lab-token-abc123"
  },
  "statusLine": {
    "type": "command",
    "command": "bash .claude/statusline.sh",
    "padding": 0
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Edit(app/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "Edit(scripts/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(cat .env*)",
      "Bash(rm -rf *)"
    ]
  }
}
