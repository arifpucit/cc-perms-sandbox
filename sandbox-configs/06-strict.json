{
  "model": "claude-opus-5",
  "effortLevel": "high",
  "permissions": {
    "allow": ["Bash(git log *)", "Bash(git -C ../cc-shared status)"],
    "deny": ["Bash(git push *)"],
    "defaultMode": "default"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": ["docker *"]
  }
}
