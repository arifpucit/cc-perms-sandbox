{
  "model": "claude-opus-5",
  "effortLevel": "high",
  "permissions": {
    "allow": ["Bash(git log *)", "Bash(git -C ../cc-shared status)"],
    "deny": ["Bash(git push *)"],
    "defaultMode": "default"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "failIfUnavailable": true,
    "filesystem": { "denyRead": ["~/"], "allowRead": ["."] },
    "credentials": {
      "files":   [{ "path": "~/.lab-secrets", "mode": "deny" }],
      "envVars": [{ "name": "LAB_TOKEN", "mode": "deny" }]
    }
  }
}
